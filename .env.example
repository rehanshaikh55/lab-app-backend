# Copy to .env for local development. On Render, set these under Environment
# (render.yaml declares them). Never commit a real .env.

PORT=3000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=labzy

# Long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_PASSWORD=

FRONTEND_URL=http://localhost:3000

# Email (OTP / notifications)
EMAIL_USER=
EMAIL_PASS=

GOOGLE_MAPS_API_KEY=

# Firebase (storage + push). On Render: /etc/secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_STORAGE_BUCKET=
FCM_ENABLED=false

# Razorpay. Without keys the app runs in stub mode; in production stub webhooks
# are rejected unless PAYMENTS_ALLOW_UNSIGNED_STUB_WEBHOOKS=true (testing only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# PAYMENTS_ALLOW_UNSIGNED_STUB_WEBHOOKS=false
